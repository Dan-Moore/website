---
import { Site } from "@/consts";
---

<div class="max-lg:collapse bg-base-200 lg:mb-48 shadow-sm w-full rounded-md">
    <input id="navbar-1-toggle" class="peer hidden" type="checkbox" />
    <label
        for="navbar-1-toggle"
        class="fixed inset-0 hidden max-lg:peer-checked:block"></label>
    <div class="collapse-title navbar">
        <div class="navbar-start">
            <label for="navbar-1-toggle" class="btn btn-ghost lg:hidden">
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="h-5 w-5"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    ><path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M4 6h16M4 12h8m-8 6h16"></path></svg
                >
            </label>
            <button class="btn btn-ghost text-xl"><a href="/">Home</a></button>
        </div>
        <div class="navbar-center hidden lg:flex">
            <ul class="menu menu-horizontal px-1">
                <li>
                    <a href="/posts">Blog</a>
                </li>
                <li>
                    <details>
                        <summary>Guides</summary>
                        <ul class="p-2 bg-base-100 w-40 z-1">
                            <li><a href="/guides/git">Git</a></li>
                        </ul>
                    </details>
                </li>
                <li><button>Projects</button></li>
                <li><button>Resources</button></li>
            </ul>
        </div>
        <!-- Site Settings Sidebar -->
        <div class="navbar-end drawer drawer-end">
            <input id="my-drawer-5" type="checkbox" class="drawer-toggle" />
            <div class="drawer-content">
                <label for="my-drawer-5" class="drawer-button btn"
                    ><svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="16"
                        height="16"
                        fill="currentColor"
                        class="bi bi-list"
                        viewBox="0 0 16 16"
                    >
                        <path
                            fill-rule="evenodd"
                            d="M2.5 12a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5m0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5m0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5"
                        ></path>
                    </svg></label
                >
            </div>
            <div class="drawer-side pt-16">
                <label
                    for="my-drawer-5"
                    aria-label="close sidebar"
                    class="drawer-overlay"></label>
                <ul class="menu bg-base-200 min-h-full w-80 p-4">
                    <!-- Sidebar Content -->
                    <li>
                        <label class="select">
                            <span class="label">Theme</span>
                            <select id="theme-selector">
                                {
                                    Site.THEMES.map((theme) => (
                                        <option value={theme}>{theme}</option>
                                    ))
                                }
                            </select>
                        </label>
                    </li>
                    <li>
                        <label class="select">
                            <span class="label">Font</span>
                            <select id="font-family-selector">
                                {
                                    Site.FONT_FAMILIES.map((font) => (
                                        <option value={font}>{font}</option>
                                    ))
                                }
                            </select>
                        </label>
                    </li>
                    <li>
                        <label class="select">
                            <span class="label">Font Size</span>
                            <select id="font-size-selector">
                                {
                                    Site.FONT_SIZES.map((font) => (
                                        <option value={font}>{font}</option>
                                    ))
                                }
                            </select>
                        </label>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>
